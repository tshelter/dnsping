#include <windows.h>
#include <commctrl.h>
#include "res.h"
1 24 "app.manifest"
IDI_APP ICON "app.ico"

IDD_MAIN DIALOGEX 0, 0, 250, 304
STYLE DS_SHELLFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "DNS Ping 10 Hz  v3"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Target", IDC_H1, 8, 5, 234, 12
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 8, 18, 234, 1
    LTEXT "Target: DNS server, or any host for ICMP ping", -1, 8, 24, 234, 9
    COMBOBOX IDC_SERVER, 8, 34, 234, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Query mode", -1, 8, 52, 114, 9
    LTEXT "Domain", -1, 130, 52, 112, 9
    COMBOBOX IDC_MODE, 8, 62, 114, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    EDITTEXT IDC_DOMAIN, 130, 62, 112, 13, ES_AUTOHSCROLL
    LTEXT "Rate", -1, 8, 80, 74, 9
    LTEXT "Duration", -1, 88, 80, 74, 9
    LTEXT "Timeout", -1, 168, 80, 74, 9
    COMBOBOX IDC_RATE, 8, 90, 74, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    COMBOBOX IDC_DUR, 88, 90, 74, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_TMO, 168, 90, 74, 80, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT "Output CSV", IDC_H2, 8, 110, 234, 12
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 8, 123, 234, 1
    EDITTEXT IDC_PATH, 8, 129, 214, 13, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_BROWSE, 226, 129, 16, 13

    LTEXT "Status", IDC_H3, 8, 149, 234, 12
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 8, 162, 234, 1
    CONTROL "", IDC_GRAPH, "Static", SS_OWNERDRAW, 8, 168, 234, 62
    LTEXT "", IDC_STATS1, 8, 234, 234, 9
    LTEXT "", IDC_STATS2, 8, 244, 234, 9
    CONTROL "", IDC_PROG, PROGRESS_CLASS, WS_BORDER, 8, 256, 234, 10
    PUSHBUTTON "Analyze...", IDC_ANALYZE, 8, 272, 60, 15
    DEFPUSHBUTTON "START", IDC_START, 128, 272, 56, 15
    PUSHBUTTON "Close", IDCANCEL, 188, 272, 54, 15
    CONTROL "", IDC_STATUS, STATUSCLASSNAME, 0, 0, 0, 0, 0
END

IDD_ANALYZE DIALOGEX 0, 0, 420, 300
STYLE DS_SHELLFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Analyzer"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    AUTORADIOBUTTON "Last recording", IDC_A_LAST, 8, 8, 64, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "File...", IDC_A_FILE, 76, 8, 36, 10
    EDITTEXT IDC_A_PATH, 116, 6, 246, 13, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON "Browse...", IDC_A_BROWSE, 366, 6, 46, 13
    CONTROL "", IDC_A_GRAPH, "Static", SS_OWNERDRAW, 8, 26, 404, 104
    CONTROL "", IDC_A_SUM, WC_LISTVIEW, LVS_REPORT | LVS_NOSORTHEADER | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 8, 136, 166, 138
    CONTROL "", IDC_A_EV, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 180, 136, 232, 138
    PUSHBUTTON "Copy report", IDC_A_COPY, 8, 280, 58, 14
    PUSHBUTTON "Open in zxc.sx", IDC_A_WEB, 70, 280, 64, 14
    LTEXT "Click an outage to highlight it; click a column to sort.", -1, 140, 283, 200, 9
    PUSHBUTTON "Close", IDCANCEL, 362, 280, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo" { BLOCK "040904b0" {
    VALUE "FileDescription", "DNS Ping 10 Hz - UDP DNS connectivity logger"
    VALUE "ProductName", "DNS Ping"
    VALUE "FileVersion", "3.0"
    VALUE "OriginalFilename", "dnsping.exe"
  } }
  BLOCK "VarFileInfo" { VALUE "Translation", 0x409, 1200 }
END
